{
  "name": "epub2pdf-platform",
  "version": "0.1.0",
  "private": true,
  "description": "EPUB to PDF Conversion Platform - monorepo (api, worker, web, shared)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "dev:api": "npm run dev --workspace packages/api",
    "dev:worker": "npm run dev --workspace packages/worker",
    "dev:web": "npm run dev --workspace packages/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "smoke-test": "node scripts/smoke-test.js",
    "cleanup": "node scripts/cleanup.js",
    "cleanup:dry-run": "node scripts/cleanup.js --dry-run",
    "infra:up": "docker compose up -d postgres redis minio minio-createbucket",
    "infra:down": "docker compose down"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0"
  }
}
