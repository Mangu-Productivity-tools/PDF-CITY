# ============================================================
# pubpdf — EPUB to PDF Conversion Platform
# Environment Variables Reference
# Copy to .env and fill in real values before running locally.
# NEVER commit .env to version control.
# ============================================================

# ---- Node ---------------------------------------------------
NODE_ENV=development           # development | production
LOG_LEVEL=info                 # trace | debug | info | warn | error

# ---- API server --------------------------------------------
API_PORT=3000

# Comma-separated list of allowed CORS origins.
# Empty = cors middleware blocks all cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:3002

# Dev bootstrap: comma-separated raw API keys seeded into the
# api_keys table on first start (dev only; see lib/apiKeys.js).
# In production, insert keys directly via SQL.
API_KEYS_BOOTSTRAP=sk_dev-local-key

# ---- PostgreSQL (Cloud SQL / self-hosted) -------------------
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/epub2pdf

# PostgreSQL connection pool size (default: 10 for API, 5 for worker)
# PG_POOL_MAX=10

# ---- Redis (Memorystore / self-hosted) ----------------------
REDIS_URL=redis://localhost:6379
# With auth: redis://:password@localhost:6379

# ---- S3-compatible object storage (GCS JSON API / MinIO) ----
S3_BUCKET_NAME=epub2pdf-conversions
S3_REGION=us-east-1

# Local MinIO endpoint — remove or leave blank for real AWS S3 / GCS:
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ---- Worker -------------------------------------------------
# Path to the Chromium binary puppeteer-core will launch.
# In Docker: set by the Dockerfile ENV block (CHROME_PATH=/usr/bin/chromium).
# Locally: `which chromium` or `which chromium-browser` or `which google-chrome`
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_PATH=/usr/bin/chromium

# Optional: path to ebook-convert binary for the Calibre engine (ADR 0004:
# Calibre is not enabled in production — this is future-use only).
# CALIBRE_PATH=/usr/bin/ebook-convert

# Max parallel BullMQ jobs per worker process
MAX_CONCURRENT_JOBS=2

# Internal health/metrics HTTP server port (GET /health, /ready, /metrics)
WORKER_HEALTH_PORT=3001

# Temp directory for in-progress conversion artifacts
TEMP_DIR=/tmp/epub2pdf

# ---- Limits (optional overrides) ----------------------------
# See packages/shared/src/constants.js for defaults.
MAX_EPUB_SIZE_MB=100
MAX_PAGE_COUNT=2000
MAX_FONT_SIZE_MB=10
SIGNED_URL_EXPIRY_SECONDS=86400   # 24 hours
OBJECT_RETENTION_DAYS=30

# ---- Rate limiting ------------------------------------------
RATE_LIMIT_RPM=60
MAX_CONCURRENT_JOBS_PER_USER=10

# ---- Web dashboard (packages/web) --------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
